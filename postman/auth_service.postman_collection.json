            ],
            "url": {
              "raw": "{{baseUrl}}/oauth/authorize?response_type=token&client_id={{clientId}}&redirect_uri=https%3A%2F%2Fclient.example.com%2Fcallback",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth",
