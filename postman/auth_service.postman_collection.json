              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "urn:ietf:params:oauth:grant-type:device_code"
                }
              ]
            },
            "description": "Unknown grant types must be rejected with `unsupported_grant_type` (RFC 6749 Section 5.2)."
          },
          "event": [
            {
              "listen": "test",
