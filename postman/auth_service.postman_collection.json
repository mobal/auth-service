                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Token — authorization code with PKCE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth/token",
