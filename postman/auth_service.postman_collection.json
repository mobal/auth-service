            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "code",
                  "value": "{{authCode}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "https://client.example.com/callback"
                },
                {
                  "key": "code_verifier",
                  "value": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
                }
              ]
            },
            "description": "Authorization codes are single-use per RFC 6749 Section 4.1.2; replaying the exchanged code must fail with `invalid_grant`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('responds with 400', () => pm.response.to.have.status(400));",
                  "pm.test('returns invalid_grant error', () => {",
                  "  pm.expect(pm.response.json().error).to.eql('invalid_grant');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Revoke",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth/revoke",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth",
                "revoke"
              ]
            },
            "description": "Revokes the bearer token (RFC 7009-style semantics): deletes the token record so the token can no longer be used."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('responds with 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Revoke — missing bearer token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oauth/revoke",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth",
                "revoke"
              ]
            },
            "description": "Requests without an Authorization header are rejected immediately with 403 (no query-parameter fallback)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('responds with 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Revoke — revoked token no longer accepted",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{revokedAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth/revoke",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth",
                "revoke"
              ]
            },
            "description": "Revocation deletes the token record (the JWT is blacklisted), so using the same token again is rejected as unauthenticated. The prerequest script snapshots the token that the previous request revoked."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('revokedAccessToken', pm.collectionVariables.get('accessToken'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('responds with 403', () => pm.response.to.have.status(403));",
                  "pm.test('rejects the revoked token as unauthenticated', () => {",
                  "  pm.expect(pm.response.json().error).to.include('Not authenticated');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
