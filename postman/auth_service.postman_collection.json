              "urlencoded": []
            },
            "description": "A request body without `grant_type` must fail with 422."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('responds with 422', () => pm.response.to.have.status(422));",
                  "pm.test('returns invalid request error', () => {",
                  "  pm.expect(pm.response.json().error).to.eql('invalid_request');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Token — password grant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "{{e2eUserEmail}}"
                },
                {
                  "key": "password",
                  "value": "{{e2ePassword}}"
                },
                {
                  "key": "scope",
                  "value": "users:read"
                }
              ]
            },
            "description": "Resource owner password credentials grant (RFC 6749 Section 4.3, deprecated). Validates the user against the user-service mock and issues an access + refresh token pair. The test scripts store both tokens."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('responds with 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns access and refresh tokens', () => {",
                  "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refresh_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.expires_in).to.eql(3600);",
                  "});",
                  "pm.test('marks the grant as deprecated', () => {",
                  "  pm.expect(pm.response.headers.get('Warning')).to.include('299');",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.access_token);",
                  "pm.collectionVariables.set('refreshToken', body.refresh_token);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Token — password grant with wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "{{e2eUserEmail}}"
                },
                {
                  "key": "password",
                  "value": "definitely-wrong"
                }
              ]
            },
            "description": "Wrong credentials must yield a generic 401 that does not leak whether the user exists."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('responds with 401', () => pm.response.to.have.status(401));",
                  "pm.test('returns generic unauthorized error', () => {",
                  "  pm.expect(pm.response.json().error).to.eql('Unauthorized');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Token — refresh token grant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refreshToken}}"
                }
              ]
            },
            "description": "Refresh token grant (RFC 6749 Section 6) with rotation: the old refresh token is consumed and a new pair is issued. The test scripts store the rotated tokens."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('responds with 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns a rotated token pair', () => {",
                  "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refresh_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refresh_token).to.not.eql(pm.collectionVariables.get('refreshToken'));",
                  "});",
                  "// Snapshot the just-consumed (pre-rotation) token before overwriting",
                  "// the variable, so the follow-up request can prove single-use rotation.",
                  "pm.collectionVariables.set('consumedRefreshToken', pm.collectionVariables.get('refreshToken'));",
                  "pm.collectionVariables.set('accessToken', body.access_token);",
                  "pm.collectionVariables.set('refreshToken', body.refresh_token);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Token — reuse of consumed refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "refresh_token",
                  "value": "{{consumedRefreshToken}}"
                }
              ]
            },
            "description": "Refresh token rotation is single-use: replaying the consumed password-grant token must fail with 404 (token not found). The refresh grant's test script snapshots the pre-rotation token into `consumedRefreshToken`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('responds with 404', () => pm.response.to.have.status(404));",
                  "pm.test('reports the token as not found', () => {",
                  "  pm.expect(pm.response.json().error).to.include('not found');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Authorize (PKCE)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth/authorize?response_type=code&client_id={{clientId}}&redirect_uri=https%3A%2F%2Fclient.example.com%2Fcallback&scope=users%3Aread&state=e2e-state&code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM&code_challenge_method=S256",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth",
                "authorize"
              ],
              "query": [
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "https://client.example.com/callback"
                },
                {
                  "key": "scope",
                  "value": "users:read"
                },
                {
                  "key": "state",
                  "value": "e2e-state"
                },
                {
                  "key": "code_challenge",
                  "value": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"
                },
                {
                  "key": "code_challenge_method",
                  "value": "S256"
                }
              ]
            },
            "description": "Authorization endpoint (RFC 6749 Section 4.1.1) with PKCE (RFC 7636). The bearer token identifies the resource owner (the sub of the current access token, resolved via the user-service mock). Returns 302 with the code and state on the registered redirect URI. The test script stores the authorization code."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('responds with 302 redirect', () => pm.response.to.have.status(302));",
                  "const location = pm.response.headers.get('Location');",
                  "pm.test('redirects to the registered URI with code and state', () => {",
                  "  pm.expect(location).to.match(/^https:\\/\\/client\\.example\\.com\\/callback\\?/);",
                  "  pm.expect(location).to.include('state=e2e-state');",
                  "  pm.expect(location).to.match(/code=[^&]+/);",
                  "});",
                  "// Newman's sandbox has no URL global — extract the code with a regex.",
                  "const codeMatch = location ? location.match(/[?&]code=([^&]+)/) : null;",
                  "if (codeMatch) {",
                  "  pm.collectionVariables.set('authCode', codeMatch[1]);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Authorize — unsupported response type",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
