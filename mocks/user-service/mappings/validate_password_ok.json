{
  "name": "Validate correct e2e password",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/api/v1/users/[^/]+/validate",
    "bodyPatterns": [
      { "equalToJson": { "password": "e2e-password" } }
    ]
  },
  "response": {
    "status": 200,
    "jsonBody": { "valid": true },
    "headers": { "Content-Type": "application/json" }
  }
}
