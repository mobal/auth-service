{
  "name": "Find user by known e2e email",
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPath": "/api/v1/users",
    "queryParameters": {
      "email": { "equalTo": "root@example.com" }
    }
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "items": [
        {
          "id": "e2e-user",
          "email": "root@example.com",
          "username": "e2e-user",
          "display_name": "E2E User",
          "roles": ["root"]
        }
      ]
    },
    "headers": { "Content-Type": "application/json" }
  }
}
